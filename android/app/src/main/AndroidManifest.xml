<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Used to sign in and to sync the choices made in the app ("I'm fine
         with this", ticked checks) with the shared Zero-Trust account,
         encrypted on the phone first. What the app reads about the phone
         (the list of apps, their permissions, the settings) is never sent
         anywhere. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- The whole point of the app: list every installed app with the
         permissions it holds. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <!-- Optional, switched on by the user under "Usage access": when each
         app was last used and how much data it moved. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <!-- Optional "deep mode": which app used the camera, microphone or
         location and when. Android never grants this to a normal app by
         itself; a computer can grant it once with
         adb shell pm grant dev.sagron.zerotrustprivacy android.permission.GET_APP_OPS_STATS -->
    <uses-permission
        android:name="android.permission.GET_APP_OPS_STATS"
        tools:ignore="ProtectedPermissions"/>
    <!-- Whether Android's Advanced Protection is on (Android 16). -->
    <uses-permission android:name="android.permission.QUERY_ADVANCED_PROTECTION_MODE"/>
    <!-- Whether Private DNS or a VPN is in use. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:supportsRtl="true"
        android:label="ZT Privacy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Links are handled by the app's own code (app_links, see
                 IncomingLinks), not Flutter's router: AppGate has no route
                 for them. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- Password-reset emails: https://zerotrust.bz/auth/privacy/#token_hash=… -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="zerotrust.bz" android:pathPrefix="/auth/privacy/"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening the privacy policy, terms and support pages. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
